apiVersion: v1
kind: Secret
metadata:
  name: electronix-db-secret
  namespace: electronix
type: Opaque
stringData:
  POSTGRES_PASSWORD: "DEFINE_A_SECURE_DB_PASSWORD_HERE"
---
apiVersion: v1
kind: Secret
metadata:
  name: electronix-redis-secret
  namespace: electronix
type: Opaque
stringData:
  REDIS_PASSWORD: "DEFINE_A_SECURE_REDIS_PASSWORD_HERE"
---
apiVersion: v1
kind: Secret
metadata:
  name: electronix-app-secret
  namespace: electronix
type: Opaque
stringData:
  JWT_SECRET: "DEFINE_A_SECURE_RANDOM_BASE64_JWT_SECRET_HERE_AT_LEAST_32_BYTES"
  ADMIN_PASSWORD: "DEFINE_A_SECURE_ADMIN_PASSWORD_HERE"
  GEMINI_API_KEY: "DEFINE_YOUR_GEMINI_API_KEY_HERE_IF_GEMINI_ENABLED"
  # Opcional si el clúster K8s no usa Workload Identity de GKE:
  # gcp-sa-key.json: |
  #   { "type": "service_account", ... }
---
apiVersion: v1
kind: Secret
metadata:
  name: electronix-monitoring-secret
  namespace: electronix
type: Opaque
stringData:
  PROMETHEUS_SCRAPE_TOKEN: "DEFINE_A_SECURE_PROMETHEUS_SCRAPE_TOKEN_HERE"
  GRAFANA_ADMIN_PASSWORD: "DEFINE_A_SECURE_GRAFANA_PASSWORD_HERE"
