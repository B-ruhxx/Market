# Electronix E-Commerce: copia a '.env' con valores reales
# Base de datos PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce_user
POSTGRES_PASSWORD=genera_una_contraseña_larga_y_unica

# Cache Distribuido Redis
REDIS_PASSWORD=genera_una_clave_redis_segura_2026

# Para ejecutar fuera de Docker o conectar con Cloud SQL privado en GCP (Camino 1):
# En GCP con Cloud SQL SSL obligatorio usa:
# SPRING_DATASOURCE_URL=jdbc:postgresql://IP_PRIVADA_CLOUD_SQL:5432/ecommerce?sslmode=require
SPRING_DATASOURCE_URL=
# Para ejecutar Spring Boot fuera de Docker en local (PostgreSQL se publica en 5435)
# Spring Boot no lee este archivo automáticamente: exporta estas variables en la terminal.
DB_URL=jdbc:postgresql://localhost:5435/ecommerce
DB_USER=ecommerce_user
DB_PASSWORD=genera_una_contraseña_larga_y_unica

# Puerto de la aplicación cuando se ejecuta fuera de Docker
PORT=8080

# Seguridad JWT (clave secreta de mínimo 256 bits)
JWT_SECRET=genera_una_clave_aleatoria_de_al_menos_32_caracteres
JWT_EXPIRATION=86400000

# Origenes permitidos para API y WS, separados por coma (sin comodines amplios)
CORS_ORIGINS=http://localhost:8090,http://localhost:8080,http://localhost:3000

# Datos de demostración reproducibles: 50 usuarios, 200 productos y 200 ventas.
# Ponlo en false únicamente para una instalación real con base propia.
DEMO_SEED_ENABLED=true

# Cuenta administradora inicial. No publiques ni compartas el archivo .env real.
ADMIN_EMAIL=Admin@gmail.com
ADMIN_PASSWORD=cambia_esta_clave_por_una_segura

# En modo demo se crean Admin@gmail.com / Admin1221:) y
# Usuario1@gmail.com / User1 hasta Usuario49@gmail.com / User49.

# Almacenamiento híbrido de imágenes (local o gcs)
# - local: guarda en disco local (APP_UPLOAD_DIR) sin credenciales GCP
# - gcs: sube directamente a Google Cloud Storage y devuelve URL pública CDN
APP_STORAGE_TYPE=local
APP_UPLOAD_DIR=uploads
GCP_STORAGE_BUCKET=
# Opcional fuera de GCP (ej. laptop/Docker en modo gcs): ruta al JSON de Service Account
GCP_CREDENTIALS_PATH=

# Monitoreo Cloud (Prometheus TSDB + Grafana)
PROMETHEUS_SCRAPE_TOKEN=genera_un_token_aleatorio_para_prometheus_2026
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=genera_una_clave_grafana_segura_2026

# HTTPS automático en GCP con Caddy + Let's Encrypt (docker-compose.tls.yml)
# Sin dominio propio puedes usar sslip.io con tu IP estática de GCP (ej. 34.123.45.67.sslip.io)
PUBLIC_DOMAIN=

# Asistente de Compras IA (Google AI Studio / Gemini)
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
